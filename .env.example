# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce_db?schema=public"

# NextAuth / Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="super-secret-nextauth-encryption-key-change-in-production-min-32-chars"

# Admin Initial Seed Credentials (Used during prisma db seed)
ADMIN_NAME="Platform Admin"
ADMIN_EMAIL="admin@ecommerce.com"
ADMIN_PASSWORD="your-admin-password"

# Cloudinary Media Storage (For Products, Categories, Customer Reviews)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="demo"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Razorpay Payments & Webhook
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Resend Transactional Emails
RESEND_API_KEY="re_placeholder_resend_api_key"
EMAIL_FROM="E-Commerce Store <onboarding@resend.dev>"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

